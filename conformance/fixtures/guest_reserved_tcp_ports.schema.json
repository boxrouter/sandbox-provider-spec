{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sandbox-provider-spec:0.1:fixture:guest-reserved-tcp-ports",
  "title": "Guest-reserved TCP-port probe inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "provider_executables"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "provider_executables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/provider_executable"}
    }
  },
  "$defs": {
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "address", "port"],
          "properties": {
            "family": {"const": "ipv4"},
            "address": {"type": "string", "format": "ipv4"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "address", "port", "ipv6_v6only"],
          "properties": {
            "family": {"const": "ipv6"},
            "address": {"type": "string", "format": "ipv6"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "ipv6_v6only": {"type": "boolean"}
          }
        }
      ]
    },
    "provider_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "provenance"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "scope"],
          "properties": {
            "source": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 256},
            "scope": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        }
      }
    }
  }
}
