{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sandbox-provider-spec:0.1:catalog-schema",
  "title": "Sandbox Provider Specification catalog",
  "description": "Machine-readable vocabulary, declaration shapes, request checks and compatibility rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "gate_order", "policy", "must_be_named", "gates", "limits", "resources", "declaration_resources", "conflicts_may_name", "lifetime_timer", "evidence", "request_keys", "image", "restores_need_keys", "at_end", "registry_policy", "rejected_before_matching", "declaration_top_level", "variant_keys", "baseline_result", "resource_descriptions"],
  "properties": {
    "spec": {"const": "sandbox-provider-spec/0.1"},
    "gate_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate_name"}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["values", "exactly_one", "any"], "properties": {"values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "exactly_one": {"type": "boolean"}, "any": {"type": "boolean"}}},
    "must_be_named": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate", "knob", "any"], "properties": {"gate": {"$ref": "#/$defs/gate_name"}, "knob": {"type": "string", "minLength": 1}, "any": {"type": "boolean"}}}},
    "gates": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/gate"}},
    "limits": {
      "type": "object",
      "description": "A limit states the kinds of value a declaration may use. If omitted, a count limit reads as unknown; unknown_fits is the maximum item count that unknown admits. floor is the smallest declaration floor accepted by the checker. A port_list limit lists values a request must not use; left out, it lists none. An entry_kind_list limit lists the allow entry kinds a variant can hold together; left out, it admits none.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "left_out", "unknown_fits"],
            "properties": {
              "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["number", "at_least", "unlimited", "unknown"]}},
              "left_out": {"const": "unknown", "description": "A missing declared limit has the same meaning as unknown."},
              "unknown_fits": {"type": "integer", "minimum": 0, "description": "How many requested items an unknown limit admits."},
              "floor": {"$ref": "#/$defs/at_least", "description": "The minimum numeric value allowed in a declared at_least floor."}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "left_out"],
            "properties": {
              "kinds": {"const": ["yes_no", "unknown"]},
              "left_out": {"const": "unknown", "description": "A missing declared yes/no limit has the same meaning as unknown."}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "left_out"],
            "properties": {
              "kinds": {"const": ["port_list"]},
              "left_out": {"const": "none_reserved", "description": "A missing declared list reserves nothing."}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "values", "left_out"],
            "properties": {
              "kinds": {"const": ["entry_kind_list"]},
              "values": {"const": ["names", "addresses"]},
              "left_out": {"const": "unknown", "description": "A missing declared list establishes no entry kind."}
            }
          }
        ]
      }
    },
    "resources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resource"}},
    "declaration_resources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resource"}},
    "resource_descriptions": {"type":"object","additionalProperties":false,"required":["arch","default_cwd","default_size","default_user","disk_in_memory","disk_mib","egress_ips","extendable_lifetime","file_stream_max_bytes","files_write_executable_effect","gpus","guest_reserved_tcp_ports","ipv4_destination_reach","kernel","kernel_features","libc","located_in","long_running","max_gpus","max_lifetime_seconds","max_process_seconds","max_run_seconds","needs","on_memory_exhausted","outbound_ip_families","outbound_traffic","package_manager","paused_retention_seconds","regions","root","size_is_ceiling","sizes","unmet_limits"],"properties":{"arch":{"type":"string","minLength":1},"default_cwd":{"type":"string","minLength":1},"default_size":{"type":"string","minLength":1},"default_user":{"type":"string","minLength":1},"disk_in_memory":{"type":"string","minLength":1},"disk_mib":{"type":"string","minLength":1},"egress_ips":{"type":"string","minLength":1},"extendable_lifetime":{"type":"string","minLength":1},"file_stream_max_bytes":{"type":"string","minLength":1},"files_write_executable_effect":{"type":"string","minLength":1},"gpus":{"type":"string","minLength":1},"guest_reserved_tcp_ports":{"type":"string","minLength":1},"ipv4_destination_reach":{"type":"string","minLength":1},"kernel":{"type":"string","minLength":1},"kernel_features":{"type":"string","minLength":1},"libc":{"type":"string","minLength":1},"located_in":{"type":"string","minLength":1},"long_running":{"type":"string","minLength":1},"max_gpus":{"type":"string","minLength":1},"max_lifetime_seconds":{"type":"string","minLength":1},"max_process_seconds":{"type":"string","minLength":1},"max_run_seconds":{"type":"string","minLength":1},"needs":{"type":"string","minLength":1},"on_memory_exhausted":{"type":"string","minLength":1},"outbound_ip_families":{"type":"string","minLength":1},"outbound_traffic":{"type":"string","minLength":1},"package_manager":{"type":"string","minLength":1},"paused_retention_seconds":{"type":"string","minLength":1},"regions":{"type":"string","minLength":1},"root":{"type":"string","minLength":1},"size_is_ceiling":{"type":"string","minLength":1},"sizes":{"type":"string","minLength":1},"unmet_limits":{"type":"string","minLength":1}}},
    "conflicts_may_name": {"type": "object", "additionalProperties": false, "required": ["resources"], "properties": {"resources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "lifetime_timer": {"type": "array", "uniqueItems": true, "items": {"enum": ["enforced_by", "counts_paused_time", "at_end", "adjustable", "step_seconds", "counts_from", "min_seconds", "after_resume"]}},
    "evidence": {"type": "object", "required": ["test_entry", "quote_entry", "paths_use_zero_based_variant_indexes", "quotable_paths"], "additionalProperties": false, "properties": {"test_entry": {"type": "object", "required": ["keys", "tests_nonempty", "report_prefix"], "additionalProperties": false, "properties": {"keys": {"const": ["tests", "report"]}, "tests_nonempty": {"type": "boolean"}, "report_prefix": {"const": "reports/"}}}, "quote_entry": {"type": "object", "required": ["keys", "quote_nonempty"], "additionalProperties": false, "properties": {"keys": {"const": ["source", "read", "quote"]}, "quote_nonempty": {"type": "boolean"}}}, "paths_use_zero_based_variant_indexes": {"type": "boolean"}, "quotable_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Declaration paths that may use documentation quotes; * matches one dotted path segment. A gate path is quotable only for an unsupported declaration.", "items": {"type": "string", "pattern": "^[a-z0-9*_.-]+$"}}}},
    "request_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "image": {"type": "object", "additionalProperties": false, "required": ["omitted", "string", "objects", "provider_artifact_names_provider"], "properties": {"omitted": {"type": "string"}, "string": {"const": "oci"}, "objects": {"type": "array", "uniqueItems": true, "items": {"enum": ["dockerfile", "private_oci", "provider_artifact"]}}, "provider_artifact_names_provider": {"type": "boolean"}}},
    "restores_need_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "at_end": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["destroyed", "paused"]}},
    "registry_policy": {"type": "object", "additionalProperties": false, "required": ["additions_are_patch_compatible", "unknown_identifier", "countries_null"], "properties": {"additions_are_patch_compatible": {"type": "boolean"}, "unknown_identifier": {"const": "does_not_match"}, "countries_null": {"const": "not_yet_known"}}},
    "rejected_before_matching": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "declaration_top_level": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "variant_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "baseline_result": {"type": "array", "uniqueItems": true, "items": {"enum": ["passed", "differs", "unsupported", "not_run", "error"]}}
  },
  "$defs": {
    "gate_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "at_least": {"type": "object", "description": "A numeric lower bound; a request up to this value is established, while a larger request is unknown.", "additionalProperties": false, "required": ["at_least"], "properties": {"at_least": {"type": "number", "exclusiveMinimum": 0}}},
    "knob": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"description": {"type": "string", "minLength": 1}, "kind": {"enum": ["pick", "all_of", "yes_no", "number"], "description": "all_of: a request lists the values it needs, and a variant fits only when it offers every one."}, "values": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "must_be_named": {"type": "boolean", "description": "The request must name this knob. any controls whether naming it without choosing a value is allowed."}, "any": {"type": "boolean"}, "exactly_one": {"type": "boolean", "description": "A request must accept exactly one value for this knob."}, "one_value": {"type": "boolean"}, "only_when": {"oneOf":[{"type":"object","description":"This knob applies only when the named sibling knob satisfies the condition.","additionalProperties":false,"required":["knob"],"properties":{"knob":{"type":"string"},"equals":{"description":"The sibling knob must equal this value."},"includes":{"type":"string","description":"The sibling knob's accepted values must include this value."},"in":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"},"description":"The sibling knob's values must include one of these."}}},{"type":"object","description":"This knob applies when any listed sibling condition holds.","additionalProperties":false,"required":["any_of"],"properties":{"any_of":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["knob","equals"],"properties":{"knob":{"type":"string"},"equals":{}}}}}}]}, "only_when_exact": {"type": "boolean"}}},
    "setting": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"type": ["string", "array"]}, "required": {"type": "boolean"}, "distinct": {"type": "boolean"}, "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "item": {}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "only_with": {"type": "object", "description": "This setting is permitted only when the named knob equals the given value.", "additionalProperties": false, "required": ["knob"], "properties": {"knob": {"type": "string"}, "equals": {}}}, "required_for": {"type": "array", "description": "The setting is required when the controlling knob has one of these values.", "items": {"type": "string"}}, "forbidden_with": {"type": "array", "description": "The setting is forbidden when the controlling knob has one of these values.", "items": {"type": "string"}}, "distinct_by": {"type": "array", "items": {"type": "string"}}, "wildcards": {"type": "boolean", "description": "false: no entry may be a wildcard such as *.example.com."}}},
    "declared_value": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["yes_no", "list"]}, "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "item": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "integer"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}}}, "distinct": {"type": "boolean"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["knobs", "settings", "limits"], "properties": {"description": {"type": "string", "minLength": 1}, "request_field": {"type": "string"}, "knobs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/knob"}}, "settings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/setting"}}, "limits": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "declaration_only": {"type": "object", "description": "Values a provider may write in its declaration; requests cannot set them.", "additionalProperties": {"$ref": "#/$defs/declared_value"}}}},
    "resource": {"type":"object","additionalProperties":false,"properties":{"description":{"type":"string","minLength":1},"kind":{"type":"string"},"values":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"registry":{"type":["string","array"],"items":{"type":"string"}},"list":{"type":"boolean"},"minimum":{"type":"number"},"greater_than":{"type":"number"},"unknown_identifier":{"const":"no_match"},"kinds":{"type":"array","items":{"type":"string"}},"floor":{"$ref":"#/$defs/at_least"},"nonempty":{"type":"boolean","description":"A declared list may not be empty."},"fields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"},"description":"A per_operation value is an object with these keys, each optional."},"item":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"integer"},"minimum":{"type":"number"},"maximum":{"type":"number"}}},"left_out":{"const":"unknown"}}}
  }
}
